[Unit]
Description=Japan Life Base community
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jplifebase
Group=jplifebase
WorkingDirectory=/srv/jplifebase/current
ExecStart=/opt/whyfshenlab/node/bin/node server.mjs
Environment=NODE_ENV=production
Environment=PORT=8797
Environment=JPL_DATA_DIR=/var/lib/jplifebase
Environment=COOKIE_SECURE=1
Environment=NODE_OPTIONS=--max-old-space-size=192
EnvironmentFile=/etc/jplifebase/app.env
StateDirectory=jplifebase
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/jplifebase
MemoryMax=384M
TasksMax=64

[Install]
WantedBy=multi-user.target
